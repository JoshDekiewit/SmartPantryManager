<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/textViewSettingsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="28sp"
        android:textStyle="bold"
        android:paddingBottom="24dp" />

    <TextView
        android:id="@+id/textViewAppName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Smart Pantry Manager"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/textViewAppDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage your pantry and find recipes based on the ingredients you have available."
        android:textSize="16sp"
        android:paddingBottom="24dp" />

    <TextView
        android:id="@+id/textViewDatabaseInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Database: Local SQLite Database"
        android:textSize="16sp"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/textViewRecipeInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recipes: 15 seeded recipes"
        android:textSize="16sp"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/textViewMatchingInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recipe matching: Strict ingredient and quantity matching"
        android:textSize="16sp" />

</LinearLayout>